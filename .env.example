# Copy to .env.prod (staging: .env.staging) on the server. Never commit real values.
# Every name here is read by backend/vayu/settings (base.py, prod.py). See docs/runbook-new-server.md.
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=app.carcid.in,verify.carcid.in
CSRF_TRUSTED_ORIGINS=https://app.carcid.in,https://verify.carcid.in
# Caddy serves the web app and the API on APP_HOST, the customer check page on VERIFY_HOST
APP_HOST=app.carcid.in
VERIFY_HOST=verify.carcid.in
# absolute links in webhook payloads (ZIP links); required in production
PUBLIC_BASE_URL=https://app.carcid.in
# where the QR on every report points
VERIFY_BASE_URL=https://verify.carcid.in
# production | test | local (test data and wipes only where it says test or local; anything else,
# the default included, counts as production). The name is typed back to confirm a wipe or a
# forced setup.
VAYU_SERVER_KIND=production
VAYU_SERVER_NAME=prod-1
DB_NAME=vayu
DB_USER=vayu
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
# required in production (the server will not start without it)
SENTRY_DSN=
# staging on the staging server, production on prod (read by the Sentry SDK automatically)
SENTRY_ENVIRONMENT=production
# Web portal errors (vayu-web project). Read when the web is BUILT; empty = web Sentry off.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
# Source maps: with a token the build uploads them to Sentry and deletes them, so they are never served.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=vayu-web

# Cloudflare R2 (media, PDFs, ZIPs): each server has its own bucket and key pair
S3_BUCKET=vayu-prod
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Firebase push: the service-account JSON, kept outside the repo. FIREBASE_JSON is its path on the
# server (compose mounts it read-only); FIREBASE_CREDENTIALS_FILE is where the containers see it.
# /api/v1/health reports "degraded" when the file is set but missing.
FIREBASE_JSON=/srv/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
# apps older than this version code cannot start new leads
MIN_APP_VERSION=0
# hours before an unfinished upload is a "stuck upload" problem
STUCK_UPLOAD_HOURS=6
