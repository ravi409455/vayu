# Copy to .env.prod (staging: .env.staging) on the server. Never commit real values.
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=app.carcid.in
CSRF_TRUSTED_ORIGINS=https://app.carcid.in
APP_HOST=app.carcid.in
DB_NAME=vayu
DB_USER=vayu
DB_PASSWORD=change-me
DB_HOST=postgres
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=

# Cloudflare R2 (media, PDFs, ZIPs). Used from Phase 6.
# Local development uses the STAGING bucket; the prod key pair lives only on the prod server.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vayu-staging
