# Copy to /srv/vayu/.env.prod (staging: .env.staging) on the server. Never commit real values.
# Secrets come from Phase; each server has its own (none shared). See docs/runbook-new-server.md.
# Staging values are in the comments marked "staging:".

# --- this server ---
# production | test | local (test data and wipes only where it says test or local; anything else,
# the default included, counts as production). The name is typed back to confirm a wipe or a
# forced setup.
VAYU_SERVER_KIND=production          # staging: test
VAYU_SERVER_NAME=prod-1              # staging: staging-1
APP_HOST=vayu.carcid.in              # staging: vayu-staging.carcid.in
ALLOWED_HOSTS=vayu.carcid.in         # staging: vayu-staging.carcid.in
CSRF_TRUSTED_ORIGINS=https://vayu.carcid.in
# absolute links in webhook payloads (ZIP links); required in production
PUBLIC_BASE_URL=https://vayu.carcid.in
# where the QR on every report points (the web app's customer page)
VERIFY_BASE_URL=https://vayu.carcid.in/report/verify
DJANGO_SECRET_KEY=                   # secret: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- sizes: both servers start on 2 vCPU / 4 GB (production's database is managed, so the box
# only runs the app). If production moves to 4 vCPU / 8 GB: 4, 4, 2, 4g ---
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
ZIP_CONCURRENCY=1
PDF_MEM_LIMIT=1500m
# Content rules (CSP): enforced. Staging only, for its first runs: Content-Security-Policy-Report-Only
# (the browser reports what it would block); switch back once a full run shows nothing blocked.
CSP_HEADER=Content-Security-Policy   # staging, at first: Content-Security-Policy-Report-Only

# --- database ---
DB_NAME=vayu
DB_USER=vayu
DB_PASSWORD=                         # secret
DB_HOST=                             # prod: the managed database's private (VPC) host; staging: postgres
DB_PORT=25060                        # prod managed database; staging: 5432
DB_SSLMODE=require                   # staging: prefer

# --- errors (Sentry) ---
# required in production (the server will not start without it)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production        # staging: staging
# The web DSN is not here: GitHub Actions bakes it into the one web image (repo variable).

# --- Cloudflare R2 (media, PDFs, ZIPs): each server has its own bucket and key pair ---
S3_BUCKET=vayu-prod                  # staging: vayu-staging
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=                    # secret (token vayu-prod-app / vayu-staging-app)
S3_SECRET_ACCESS_KEY=                # secret
S3_REGION=auto

# --- backups (infra/backup.sh) ---
BACKUP_BUCKET=vayu-backups
BACKUP_PREFIX=prod                   # staging: staging
BACKUP_ACCESS_KEY_ID=                # secret (token vayu-backups-writer)
BACKUP_SECRET_ACCESS_KEY=            # secret
# the LOCKING half of the backup key (age1...): not a secret. The unlocking half lives in Phase only.
BACKUP_PUBLIC_KEY=

# --- uptime checker heartbeats (Better Stack); treat as secrets ---
BACKUP_HEARTBEAT_URL=
WORKERS_HEARTBEAT_URL=

# --- push (Firebase) ---
# The service-account JSON, kept outside the repo. FIREBASE_JSON is its path on the server
# (compose mounts it read-only); FIREBASE_CREDENTIALS_FILE is where the containers see it.
# /api/v1/health reports "degraded" when the file is set but missing.
FIREBASE_JSON=/srv/vayu/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# --- app behaviour ---
# apps older than this version code cannot start new leads
MIN_APP_VERSION=0
# hours before an unfinished upload is a "stuck upload" problem
STUCK_UPLOAD_HOURS=6
