# Copy to .env.prod (staging: .env.staging) on the server. Never commit real values.
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=app.carcid.in
CSRF_TRUSTED_ORIGINS=https://app.carcid.in
APP_HOST=app.carcid.in
DB_NAME=vayu
DB_USER=vayu
DB_PASSWORD=change-me
DB_HOST=postgres
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=
# staging on the staging server, production on prod (read by the Sentry SDK automatically)
SENTRY_ENVIRONMENT=production
# Web portal errors (vayu-web project). Read when the web is BUILT; empty = web Sentry off.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
# Source maps: with a token the build uploads them to Sentry and deletes them, so they are never served.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=vayu-web

# Cloudflare R2 (media, PDFs, ZIPs). Used from Phase 6.
# Local development uses the STAGING bucket; the prod key pair lives only on the prod server.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vayu-staging

# Firebase push (Phase 15). Path to the service-account JSON, kept OUTSIDE the repo.
FIREBASE_CREDENTIALS_FILE=/Users/you/vayu-keys/firebase-service-account.json
S3_BUCKET=vayu-prod
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
