# The NON-SECRET settings of the production server. Paste this whole file into Phase:
# app vayu → New Secret menu → Import secrets → import into Production only → Preview Import → Deploy.
# DB_HOST is the managed database's private (VPC) host: fill it in when the database exists (plan 7.2).
# The secrets themselves are added by hand (docs/runbook-new-server.md §1); never put them here.
VAYU_SERVER_KIND=production
VAYU_SERVER_NAME=prod-1
APP_HOST=vayu.carcid.in
ALLOWED_HOSTS=vayu.carcid.in
CSRF_TRUSTED_ORIGINS=https://vayu.carcid.in
PUBLIC_BASE_URL=https://vayu.carcid.in
VERIFY_BASE_URL=https://vayu.carcid.in/report/verify
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
ZIP_CONCURRENCY=1
PDF_MEM_LIMIT=1500m
CSP_HEADER=Content-Security-Policy
DB_NAME=vayu
DB_USER=vayu
DB_HOST=to-be-filled-private-host
DB_PORT=25060
DB_SSLMODE=require
SENTRY_ENVIRONMENT=production
S3_BUCKET=vayu-prod
S3_REGION=auto
BACKUP_BUCKET=vayu-backups
BACKUP_PREFIX=prod
MIN_APP_VERSION=0
STUCK_UPLOAD_HOURS=6
