# The NON-SECRET settings of the staging server. Paste this whole file into Phase:
# app vayu → New Secret menu → Import secrets → import into Staging only → Preview Import → Deploy.
# The secrets themselves are added by hand (docs/runbook-new-server.md §1); never put them here.
VAYU_SERVER_KIND=test
VAYU_SERVER_NAME=staging-1
APP_HOST=vayu-staging.carcid.in
ALLOWED_HOSTS=vayu-staging.carcid.in
CSRF_TRUSTED_ORIGINS=https://vayu-staging.carcid.in
PUBLIC_BASE_URL=https://vayu-staging.carcid.in
VERIFY_BASE_URL=https://vayu-staging.carcid.in/report/verify
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
ZIP_CONCURRENCY=1
PDF_MEM_LIMIT=1500m
CSP_HEADER=Content-Security-Policy
DB_NAME=vayu
DB_USER=vayu
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=prefer
SENTRY_ENVIRONMENT=staging
S3_BUCKET=vayu-staging
S3_REGION=auto
BACKUP_BUCKET=vayu-backups
BACKUP_PREFIX=staging
MIN_APP_VERSION=0
STUCK_UPLOAD_HOURS=6
