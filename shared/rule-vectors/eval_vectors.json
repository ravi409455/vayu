   ]
  },
  "data": {},
  "expected": 3.5
 },
 {
  "name": "modulo",
  "rule": {
   "%": [
    7,
    2
   ]
  },
  "data": {},
  "expected": 1
 },
 {
  "name": "min",
  "rule": {
   "min": [
    3,
    1,
    2
   ]
  },
  "data": {},
  "expected": 1
 },
 {
  "name": "max",
  "rule": {
   "max": [
    3,
    1,
    2
   ]
  },
  "data": {},
  "expected": 3
 },
 {
  "name": "cat",
  "rule": {
   "cat": [
    "a",
    1,
    "b"
   ]
  },
  "data": {},
  "expected": "a1b"
 },
 {
  "name": "substr",
  "rule": {
   "substr": [
    "Vayu",
    1,
    2
   ]
  },
  "data": {},
  "expected": "ay"
 },
 {
  "name": "substr negative",
  "rule": {
   "substr": [
    "Vayu",
    -2
   ]
  },
  "data": {},
  "expected": "yu"
 }
]